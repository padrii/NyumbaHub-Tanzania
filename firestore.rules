rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.owner_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.provider_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /service_requests/{requestId} {
      allow read: if signedIn() && (resource.data.tenant_id == request.auth.uid || resource.data.provider_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.tenant_id == request.auth.uid;
      allow update: if signedIn() && (resource.data.tenant_id == request.auth.uid || resource.data.provider_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
